# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form submissions are delivered.
# Comma-separate for multiple recipients.
CONTACT_TO_EMAIL=hello@teambodymechanik.com

# Sender shown on the notification email. The domain must be verified in
# Resend — https://resend.com/domains
# For a quick test before verifying a domain, Resend allows:
#   CONTACT_FROM_EMAIL="Team BodyMechanik <onboarding@resend.dev>"
CONTACT_FROM_EMAIL="Team BodyMechanik <noreply@teambodymechanik.com>"

# Staging only: stop search engines indexing this copy of the site.
# Leave unset on the live site. Takes effect on the next build.
# NOINDEX=true

# Port for panels that start server.js without passing PORT (sPanel NodeJS
# Manager). Baked in by `npm run build:standalone`; a PORT set in the
# environment still wins. Staging: 3003.
# PORT=3003
